{
  "root": true,
  "extends": ["next/core-web-vitals", "plugin:jsx-a11y/recommended", "prettier"],
  "plugins": ["jsx-a11y", "@typescript-eslint"],
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/lib/content/data/*", "**/lib/content/data"],
            "message": "Import content through lib/content/queries.ts, never lib/content/data directly."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["lib/content/index.ts", "lib/content/queries.ts", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
